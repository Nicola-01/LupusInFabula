# Copy to /home/deployer/.env on the prod server (never commit .env).
# Dev (docker-compose.yml) does not need it: application.properties has dev defaults.

# --- Database ---
POSTGRES_PASSWORD=   # postgres superuser, openssl rand -base64 24
DB_PASSWORD=         # app role lupus_sql, openssl rand -base64 24

# --- Auth ---
JWT_SECRET=         # openssl rand -base64 48 (at least 32 characters)

# --- Optional ---
WEB_PORT=9090        # host port exposed to the reverse proxy / tunnel

# --- Added by CI at every deploy, do not set by hand ---
# GHCR_OWNER, APP_TAG, APP_VERSION
